# Python build/cache artifacts
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Model checkpoints
*.pth
*.pt
*.ckpt

# Outputs
checkpoints/

# Logs
logs/
*.log
*.out
*.err

# Personal working notes, not part of the tracked project
todo.txt

# Derived/regeneratable images. The Phase 0 data/raw_images/*.zip archives
# (one per species) are the one intentional exception - already tracked in
# git before this rule was added, so it doesn't affect them. This rule
# stops *future* zips/PNGs (e.g. Phase 1's standardized_images output) from
# being tracked - those are meant to be regenerated locally via the
# pipeline, not committed. Phase 1's first step unzips data/raw_images/
# back into loose files before processing (see dataset_builder.archive).
*.zip
*.png

# NOTE: results are deliberately NOT ignored. The rule above is about large,
# regeneratable *binaries*; the result tables under outputs/ and reports/ are
# the scientific record - small CSVs (tens of KB) that every number in
# README.md traces back to. A clone has to be able to check those numbers
# without re-running a GPU pipeline, so they are tracked on purpose.
# Deliberately excluded from that: the per-run diagnostic bundles the Phase 2
# notebook produces for visual review (pattern_diagnostics*.zip, tens of MB,
# regenerated on demand), already covered by the *.zip rule above.


# Coverage data
.coverage
coverage.xml
htmlcov/
